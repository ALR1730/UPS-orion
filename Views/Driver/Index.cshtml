@{
    ViewData["Title"] = "App Conductor";
}

<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">App Móvil Conductor</h1>
    <p style="color: var(--text-muted);">Módulo móvil para navegación, secuencia 1..N, odómetro y cancelación (HU04 - HU06, HU10).</p>
</div>

<div class="glass-card">
    <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-mobile-screen-button" style="font-size: 3rem; color: var(--accent-blue); margin-bottom: 1rem;"></i>
        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">Estructura Base del Módulo Conductor</h3>
        <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 1.5rem auto;">
            Listo para recibir la secuencia de entregas y control de odómetro.
        </p>
        <span class="status-badge status-pending">Esperando HU04</span>
    </div>
</div>
