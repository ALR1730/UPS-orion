@{
    ViewData["Title"] = "Panel Principal - UPS ORION MVP";
}

<div style="text-align: center; margin-bottom: 3rem;">
    <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; background: linear-gradient(135deg, #fff, #94a3b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        UPS ORION - Sistema de Optimización de Rutas
    </h1>
    <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 650px; margin: 0 auto;">
        MVP Piloto desarrollado en C# (.NET 10) para secuenciación inteligente de paradas, geocodificación, telemetría y navegación vehicular.
    </p>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
    
    <!-- Módulo Despacho -->
    <div class="glass-card">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            <div style="background: rgba(255, 181, 0, 0.15); color: var(--ups-gold); padding: 12px; border-radius: 12px; font-size: 1.5rem;">
                <i class="fa-solid fa-truck-ramp-box"></i>
            </div>
            <div>
                <h3 style="font-weight: 700; font-size: 1.2rem;">Despachador del Piloto</h3>
                <span class="status-badge status-pending">HU01 - HU03</span>
            </div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            Carga de planillas (CSV/Excel), geocodificación automática de direcciones y ejecución del algoritmo estático secuenciador (TSP Nearest Neighbor).
        </p>
        <a asp-controller="Dispatch" asp-action="Index" class="btn-orion-primary" style="width: 100%;">
            Acceder a Despacho <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <!-- Módulo Conductor -->
    <div class="glass-card">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            <div style="background: rgba(56, 189, 248, 0.15); color: var(--accent-blue); padding: 12px; border-radius: 12px; font-size: 1.5rem;">
                <i class="fa-solid fa-mobile-button"></i>
            </div>
            <div>
                <h3 style="font-weight: 700; font-size: 1.2rem;">App Móvil Conductor</h3>
                <span class="status-badge status-active">HU04 - HU06, HU10</span>
            </div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            Visualización vertical de paradas 1..N, navegación GPS nativa (Google Maps / Waze), registro de odómetro inicial/final y motivo de cancelación.
        </p>
        <a asp-controller="Driver" asp-action="Index" class="btn-orion-secondary" style="width: 100%;">
            Abrir Vista Conductor <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

    <!-- Módulo Supervisor -->
    <div class="glass-card">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            <div style="background: rgba(34, 197, 94, 0.15); color: var(--accent-green); padding: 12px; border-radius: 12px; font-size: 1.5rem;">
                <i class="fa-solid fa-chart-pie"></i>
            </div>
            <div>
                <h3 style="font-weight: 700; font-size: 1.2rem;">Panel de Supervisor</h3>
                <span class="status-badge status-delivered">HU07, HU08, HU09</span>
            </div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            Supervisión en vivo de flujos de despacho, reportes de comparación de distancia real vs histórica y gráfico de porcentaje de ahorro de combustible.
        </p>
        <a asp-controller="Supervisor" asp-action="Index" class="btn-orion-secondary" style="width: 100%;">
            Ver Dashboard Supervisor <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>

</div>

<!-- Estado de Historias -->
<div class="glass-card">
    <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-list-check" style="color: var(--ups-gold);"></i> Estado de Historias de Usuario
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px;">
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem;">
            <strong style="color: var(--accent-green);">✓ HU00:</strong> Estructura e Infraestructura C#
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU01:</strong> Carga Excel/CSV
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU02:</strong> Geocodificación Básica
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU03:</strong> Secuenciador TSP
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU04:</strong> Vista Móvil Conductor
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU05:</strong> Enlace Maps / Waze
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU06:</strong> Odómetro Inicial/Final
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU07:</strong> Reporte Comparativo KM
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU08:</strong> BD Local del Piloto
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU09:</strong> Panel Control Despacho
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <strong>HU10:</strong> Cancelación de Parada
        </div>
    </div>
</div>
