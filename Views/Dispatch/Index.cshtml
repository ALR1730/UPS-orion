@model IEnumerable<OrionMVP.Models.Route>
@{
    ViewData["Title"] = "Carga Centralizada de Artículos CSV (HU02)";
    var drivers = ViewBag.Drivers as List<OrionMVP.Models.Driver> ?? new List<OrionMVP.Models.Driver>();
}

<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span class="brand-badge"><i class="fa-solid fa-layer-group"></i> ÉPICA SCRUM-41 & SCRUM-42</span>
            <h1 style="font-size: 2rem; font-weight: 800; margin-top: 0.35rem; margin-bottom: 0.25rem;">
                <i class="fa-solid fa-file-csv" style="color: var(--ups-gold);"></i> Ingesta y Secuenciación de Artículos (HU02 / HU03)
            </h1>
            <p style="color: var(--text-muted);">Carga masiva de artículos y ordenamiento automatizado por algoritmo de cercanía lineal.</p>
        </div>
        <a asp-action="DownloadSampleCsv" class="btn-orion-secondary">
            <i class="fa-solid fa-download"></i> Descargar Plantilla CSV (15 Artículos Piloto)
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px;">
        <i class="fa-solid fa-circle-check" style="font-size: 1.5rem;"></i>
        <div>
            <strong style="display: block; font-size: 1rem;">¡Operación Exitosa!</strong>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px;">
        <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem;"></i>
        <div>
            <strong style="display: block; font-size: 1rem;">Error de Validación en el Archivo</strong>
            <span>@TempData["ErrorMessage"]</span>
            @if (TempData["MissingColumns"] != null)
            {
                <div style="margin-top: 5px; font-weight: 700;">
                    Columnas requeridas faltantes: <span style="text-decoration: underline;">@TempData["MissingColumns"]</span>
                </div>
            }
        </div>
    </div>
}

<!-- Upload Form Card (HU02) -->
<div class="glass-card" style="margin-bottom: 2.5rem; border: 1px solid rgba(255, 181, 0, 0.3);">
    <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--ups-gold);">
        <i class="fa-solid fa-cloud-arrow-up"></i> Carga Centralizada de Artículos (CSV Express)
    </h3>
    
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        <div style="display: grid; grid-template-columns: 1fr 280px; gap: 1.5rem; align-items: end;">
            
            <div style="border: 2px dashed rgba(255, 181, 0, 0.4); border-radius: 12px; padding: 2rem; text-align: center; background: rgba(0, 0, 0, 0.2); transition: all 0.2s ease;">
                <i class="fa-solid fa-file-csv" style="font-size: 2.5rem; color: var(--ups-gold); margin-bottom: 0.75rem;"></i>
                <div style="margin-bottom: 0.5rem; font-weight: 600;">Seleccione o arrastre su archivo .csv</div>
                <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
                    Columnas obligatorias: <span style="color: #fff; font-weight: 700;">Articulo</span>, <span style="color: #fff; font-weight: 700;">Cliente</span>, <span style="color: #fff; font-weight: 700;">Direccion</span>, <span style="color: #fff; font-weight: 700;">Latitud</span>, <span style="color: #fff; font-weight: 700;">Longitud</span>
                </div>
                <input type="file" name="file" accept=".csv" required style="display: block; margin: 0 auto; color: var(--text-muted);" />
            </div>

            <div>
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem;">Asignar a Conductor del Piloto:</label>
                <select name="driverId" style="width: 100%; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #fff; border: 1px solid var(--border-color); margin-bottom: 1.25rem;">
                    @foreach (var driver in drivers)
                    {
                        <option value="@driver.Id">@driver.Name (@driver.VehicleId)</option>
                    }
                </select>

                <button type="submit" class="btn-orion-primary" style="width: 100%; padding: 0.85rem;">
                    <i class="fa-solid fa-bolt"></i> Cargar y Optimizar Ruta
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Loaded Routes List -->
<div class="glass-card">
    <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-route" style="color: var(--accent-blue);"></i> Rutas Activas del Piloto
    </h3>

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
            No hay rutas cargadas aún. Use el formulario superior o descargue la plantilla CSV de prueba para iniciar.
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase;">
                        <th style="padding: 12px;">ID Ruta</th>
                        <th style="padding: 12px;">Ruta / Jornada</th>
                        <th style="padding: 12px;">Conductor</th>
                        <th style="padding: 12px;">Artículos</th>
                        <th style="padding: 12px;">Distancia Est.</th>
                        <th style="padding: 12px;">Estado</th>
                        <th style="padding: 12px; text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var route in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <td style="padding: 14px; font-weight: 700;">#@route.Id</td>
                            <td style="padding: 14px;">
                                <div style="font-weight: 600;">@route.Name</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">@route.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td style="padding: 14px;">
                                <i class="fa-solid fa-user-circle" style="color: var(--ups-gold);"></i> @(route.Driver?.Name ?? "Sin Asignar")
                            </td>
                            <td style="padding: 14px;">
                                <span class="status-badge status-active">
                                    <i class="fa-solid fa-box"></i> @route.Stops.Count artículos
                                </span>
                            </td>
                            <td style="padding: 14px; font-weight: 700; color: var(--accent-blue);">
                                @route.TotalDistanceKm km
                            </td>
                            <td style="padding: 14px;">
                                @if (route.Status == "No iniciado")
                                {
                                    <span class="status-badge status-pending">No iniciado</span>
                                }
                                else if (route.Status == "En Ruta")
                                {
                                    <span class="status-badge status-active">En Ruta</span>
                                }
                                else
                                {
                                    <span class="status-badge status-delivered">Finalizado</span>
                                }
                            </td>
                            <td style="padding: 14px; text-align: right;">
                                <a asp-controller="Dispatch" asp-action="RouteDetails" asp-route-id="@route.Id" class="btn-orion-secondary" style="padding: 6px 12px; font-size: 0.85rem;">
                                    <i class="fa-solid fa-list-ol"></i> Ver Hoja Secuenciada
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
