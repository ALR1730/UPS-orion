@model OrionMVP.Models.Route
@{
    ViewData["Title"] = $"Secuencia de Ruta #{Model.Id} - ORION";
}

<div style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <a asp-action="Index" class="btn-orion-secondary" style="padding: 6px 12px; margin-bottom: 0.5rem;">
                <i class="fa-solid fa-arrow-left"></i> Volver a Lista de Rutas
            </a>
            <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.25rem;">
                @Model.Name
            </h1>
            <p style="color: var(--text-muted);">
                Conductor Asignado: <strong>@(Model.Driver?.Name ?? "Sin Asignar")</strong> | Total Artículos: <strong>@Model.Stops.Count</strong> | Distancia Optimizada: <strong style="color: var(--ups-gold);">@Model.TotalDistanceKm km</strong>
            </p>
        </div>
        
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <form asp-action="OptimizeSequence" method="post">
                <input type="hidden" name="routeId" value="@Model.Id" />
                <button type="submit" class="btn-orion-primary">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Re-ejecutar Secuenciador (HU03)
                </button>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px;">
        <i class="fa-solid fa-circle-check" style="font-size: 1.5rem;"></i>
        <div>
            <strong>¡Secuencia Calculada!</strong>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    </div>
}

<!-- Optimization & Stats Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase;">Artículos / Paradas</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: var(--ups-gold);">@Model.Stops.Count</div>
    </div>
    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase;">Distancia Mínima Lineal</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: var(--accent-blue);">@Model.TotalDistanceKm km</div>
    </div>
    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase;">Ahorro Proyectado vs Histórico</div>
        <div style="font-size: 1.75rem; font-weight: 800; color: var(--accent-green);">
            <i class="fa-solid fa-leaf"></i> ~10.5% <span style="font-size: 0.8rem; font-weight: 400; color: var(--text-muted);">(Meta Piloto: 8% a 10%)</span>
        </div>
    </div>
</div>

<!-- Route Stops Table / Cards (HU03) -->
<div class="glass-card">
    <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
        <i class="fa-solid fa-list-ol" style="color: var(--ups-gold);"></i> Secuencia Optimizada de Paradas (1 a N)
    </h3>

    <div style="display: flex; flex-direction: column; gap: 0.85rem;">
        @foreach (var stop in Model.Stops)
        {
            <div style="border: 1px solid var(--border-color); background: rgba(255, 255, 255, 0.03); border-radius: 12px; padding: 1.1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background: linear-gradient(135deg, var(--ups-gold), #f59e0b); color: #111; font-weight: 800; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                        #@stop.SequenceOrder
                    </div>
                    <div>
                        <div style="font-weight: 800; font-size: 1.1rem; color: #fff;">
                            <i class="fa-solid fa-box" style="color: var(--ups-gold); margin-right: 6px;"></i> @stop.ArticleName
                        </div>
                        <div style="color: var(--text-muted); font-size: 0.95rem; margin-top: 2px;">
                            Cliente: <strong style="color: #cbd5e1;">@stop.CustomerName</strong>
                        </div>
                        <div style="color: var(--text-main); font-size: 0.95rem; margin-top: 2px;">
                            <i class="fa-solid fa-map-pin" style="color: var(--ups-gold);"></i> @stop.FullAddress
                        </div>
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                            Coordenadas: <strong style="color: var(--accent-blue);">Lat: @stop.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture), Lng: @stop.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)</strong>
                        </div>
                    </div>
                </div>

                <div>
                    <a href="@stop.GetGoogleMapsUrl()" target="_blank" rel="noopener noreferrer" class="btn-orion-primary" style="padding: 7px 14px; font-size: 0.85rem; background: linear-gradient(135deg, #4285F4, #34A853); color: #fff;">
                        <i class="fa-solid fa-location-arrow"></i> Ver en Google Maps
                    </a>
                </div>
            </div>
        }
    </div>
</div>
