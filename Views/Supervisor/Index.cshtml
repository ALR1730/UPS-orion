@{
    ViewData["Title"] = "Panel Supervisor";
}

<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">Panel de Control Supervisor</h1>
    <p style="color: var(--text-muted);">Módulo de monitoreo de rutas, telemetría y gráficos de comparación de ahorro (HU07, HU08, HU09).</p>
</div>

<div class="glass-card">
    <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-chart-line" style="font-size: 3rem; color: var(--accent-green); margin-bottom: 1rem;"></i>
        <h3 style="font-weight: 700; margin-bottom: 0.5rem;">Estructura Base del Módulo Supervisor</h3>
        <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 1.5rem auto;">
            Listo para recibir los reportes comparativos y monitoreo de despachos.
        </p>
        <span class="status-badge status-pending">Esperando HU07</span>
    </div>
</div>
