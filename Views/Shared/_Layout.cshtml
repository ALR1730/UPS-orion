<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ORION MVP Piloto</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <nav class="navbar-orion">
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 1280px; margin: 0 auto;">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-truck-fast" style="color: var(--ups-gold);"></i>
                <span>ORION MVP</span>
                <span class="brand-badge">PILOTO 5 CONDUCTORES</span>
            </a>
            
            <ul class="nav-links">
                <li>
                    <a class="nav-link-item" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house"></i> Inicio
                    </a>
                </li>
                <li>
                    <a class="nav-link-item" asp-controller="Dispatch" asp-action="Index">
                        <i class="fa-solid fa-file-csv"></i> Despacho CSV (HU01-03)
                    </a>
                </li>
                <li>
                    <a class="nav-link-item" asp-controller="Driver" asp-action="Index">
                        <i class="fa-solid fa-mobile-screen-button"></i> App Móvil (HU04-06)
                    </a>
                </li>
                <li>
                    <a class="nav-link-item" asp-controller="Supervisor" asp-action="Index">
                        <i class="fa-solid fa-chart-line"></i> Supervisor (HU07)
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="main-container" role="main">
        @RenderBody()
    </main>

    <footer class="footer-orion">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                &copy; 2026 - ORION MVP Piloto (C# ASP.NET Core) - Proyecto Final Scrum ITLA
            </div>
            <div style="display: flex; gap: 15px; font-size: 0.85rem;">
                <span style="color: var(--ups-gold); font-weight: 700;">Sprint 1: 14 SP</span>
                <span style="color: var(--accent-green); font-weight: 700;">7 Historias Finalizadas</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
